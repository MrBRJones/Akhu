<?xml version="1.0" encoding="utf-8"?>
<!-- Centre create button: a pill in the app's own blue-purple-pink gradient (as on the banners),
     so it doesn't read as the TikTok app icon. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="0"
        android:centerColor="#8E44FF"
        android:endColor="#FF5E8A"
        android:startColor="#2F6BFF" />
    <corners android:radius="18dp" />
</shape>
