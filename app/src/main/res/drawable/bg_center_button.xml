<?xml version="1.0" encoding="utf-8"?>
<!-- Centre create button: a pill in the app's own teal-blue-violet gradient (as on the banners),
     so it doesn't read as the TikTok app icon. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="0"
        android:centerColor="#2E8FD6"
        android:endColor="#6A5ACD"
        android:startColor="#00A88F" />
    <corners android:radius="18dp" />
</shape>
