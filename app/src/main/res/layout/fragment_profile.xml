<?xml version="1.0" encoding="utf-8"?>
<!-- Profile tab: account card, then one tab per kind of saved item (like a TikTok profile).
     The card scrolls away and the tab bar sticks to the top. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardBackgroundColor="@color/surface_muted"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:layout_scrollFlags="scroll"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_avatar"
                    android:contentDescription="@null"
                    android:padding="16dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/text_primary" />

                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minWidth="160dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMyUploads"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="160dp"
                    android:text="@string/my_uploads" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/profileTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/surface"
            app:tabGravity="fill"
            app:tabIconTint="@color/profile_tab"
            app:tabIndicatorColor="@color/text_primary"
            app:tabIndicatorFullWidth="false"
            app:tabInlineLabel="true"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/text_primary"
            app:tabTextAppearance="@style/ProfileTabText"
            app:tabTextColor="@color/text_secondary">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_nav_wallpaper"
                android:text="@string/profile_2d" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_cube"
                android:text="@string/profile_3d" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_nav_motion"
                android:text="@string/profile_motion" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_nav_themes"
                android:text="@string/profile_themes" />
        </com.google.android.material.tabs.TabLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/surface_muted" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Only the selected tab's empty note and grid are shown. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="400dp"
            android:paddingHorizontal="2dp"
            android:paddingTop="2dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/page2d"
                style="@style/ProfilePage">

                <TextView
                    android:id="@+id/empty2d"
                    style="@style/ProfileEmpty"
                    android:text="@string/profile_empty_2d" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/grid2d"
                    style="@style/ProfileGrid" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/page3d"
                style="@style/ProfilePage">

                <TextView
                    android:id="@+id/empty3d"
                    style="@style/ProfileEmpty"
                    android:text="@string/profile_empty_3d" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/grid3d"
                    style="@style/ProfileGrid" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pageMotion"
                style="@style/ProfilePage">

                <TextView
                    android:id="@+id/emptyMotion"
                    style="@style/ProfileEmpty"
                    android:text="@string/profile_empty_motion" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/gridMotion"
                    style="@style/ProfileGrid" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pageThemes"
                style="@style/ProfilePage">

                <TextView
                    android:id="@+id/emptyThemes"
                    style="@style/ProfileEmpty"
                    android:text="@string/profile_empty_themes" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/gridThemes"
                    style="@style/ProfileGrid" />
            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
