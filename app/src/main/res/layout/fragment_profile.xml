<?xml version="1.0" encoding="utf-8"?>
<!-- Profile tab: account and the user's uploads (dark mode lives in Settings). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_muted"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_avatar"
                    android:contentDescription="@null"
                    android:padding="16dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/text_primary" />

                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minWidth="160dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMyUploads"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="160dp"
                    android:text="@string/my_uploads" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Everything saved on this phone, one grid per kind. -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/profile_2d" />

        <TextView
            android:id="@+id/empty2d"
            style="@style/ProfileEmpty"
            android:text="@string/profile_empty_2d" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid2d"
            style="@style/ProfileGrid" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/profile_3d" />

        <TextView
            android:id="@+id/empty3d"
            style="@style/ProfileEmpty"
            android:text="@string/profile_empty_3d" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid3d"
            style="@style/ProfileGrid" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/profile_motion" />

        <TextView
            android:id="@+id/emptyMotion"
            style="@style/ProfileEmpty"
            android:text="@string/profile_empty_motion" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/gridMotion"
            style="@style/ProfileGrid" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/profile_themes" />

        <TextView
            android:id="@+id/emptyThemes"
            style="@style/ProfileEmpty"
            android:text="@string/profile_empty_themes" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/gridThemes"
            style="@style/ProfileGrid" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
