<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: dark mode switch and app color with presets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp">

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchDark"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="@string/dark_mode"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <!-- App colors: each swatch opens the same color picker as the creation window. -->
    <LinearLayout
        android:id="@+id/rowAppColor"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_color"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetAppColor"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/reset" />

        <!-- Main and second color; each opens its own picker. -->
        <View
            android:id="@+id/appColorSwatch"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_color_swatch"
            android:contentDescription="@string/app_color_main" />

        <View
            android:id="@+id/appColorSwatch2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_color_swatch"
            android:contentDescription="@string/app_color_second" />
    </LinearLayout>

    <!-- Ready-made app colors; filled in by SettingsActivity. -->
    <LinearLayout
        android:id="@+id/appColorPresets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal" />
</LinearLayout>
