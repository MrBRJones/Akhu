<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: dark mode switch, app color, plus a shortcut to the motion settings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp">

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchDark"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="@string/dark_mode"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <!-- App color: opens the same color picker as the creation window; the swatch shows the color. -->
    <LinearLayout
        android:id="@+id/rowAppColor"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_color"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetAppColor"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/reset" />

        <View
            android:id="@+id/appColorSwatch"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_color_swatch" />
    </LinearLayout>

    <TextView
        android:id="@+id/rowMotionSettings"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/selectableItemBackground"
        android:drawableEnd="@drawable/ic_arrow_forward"
        android:drawableTint="@color/text_secondary"
        android:gravity="center_vertical"
        android:text="@string/motion_settings"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />
</LinearLayout>
