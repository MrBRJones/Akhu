<?xml version="1.0" encoding="utf-8"?>
<!-- Motion editor's sticker picker: search, Photo and Cutout, then every emoji sticker. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_editor_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="12dp">

    <EditText
        android:id="@+id/stickerSearch"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_editor_input"
        android:drawablePadding="8dp"
        android:hint="@string/search_stickers"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#80FFFFFF"
        app:drawableStartCompat="@drawable/ic_search"
        app:drawableTint="#80FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPhotoSticker"
            style="@style/EditorTab"
            android:layout_marginEnd="8dp"
            android:text="@string/sticker_photo"
            app:icon="@drawable/ic_add_photo"
            app:iconTint="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCutoutSticker"
            style="@style/EditorTab"
            android:text="@string/sticker_cutout"
            app:icon="@drawable/ic_sparkle"
            app:iconTint="#FFFFFF" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/stickerGrid"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />
</LinearLayout>
