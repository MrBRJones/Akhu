<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/theme_creation"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPost"
            style="@style/TopPill"
            android:text="@string/post" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/TopPill"
            android:text="@string/save"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/brand_primary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- Live preview: tap an icon to give it a photo, rename or remove it -->
            <com.MrBRos.wallpapercreator.PhoneFrame
                android:layout_width="wrap_content"
                android:layout_height="400dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="#FF111111"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="4dp"
                    app:contentPadding="4dp"
                    app:strokeWidth="0dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <com.MrBRos.wallpapercreator.HomeMockView
                            android:id="@+id/mock"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </com.google.android.material.card.MaterialCardView>
                </com.google.android.material.card.MaterialCardView>
            </com.MrBRos.wallpapercreator.PhoneFrame>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/screenToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                app:checkedButton="@id/btnHome"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHome"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_home" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLock"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_lock" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/tap_icon_hint"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/theme_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/nameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLength="40"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/SectionHeader"
                android:text="@string/wallpaper_header" />

            <LinearLayout style="@style/ButtonRow">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWpGallery"
                    style="@style/RowButton.Tonal"
                    android:text="@string/from_gallery" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWpFeatured"
                    style="@style/RowButton.Tonal"
                    android:text="@string/from_featured" />
            </LinearLayout>

            <TextView
                style="@style/SectionHeader"
                android:text="@string/icon_style" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/styleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <TextView
                style="@style/SectionHeader"
                android:text="@string/icon_shape" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/shapeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <TextView
                android:id="@+id/bgHeader"
                style="@style/SectionHeader"
                android:text="@string/icon_colour" />

            <HorizontalScrollView
                android:id="@+id/bgScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/bgSwatches"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/glyphHeader"
                style="@style/SectionHeader"
                android:text="@string/symbol_colour" />

            <HorizontalScrollView
                android:id="@+id/glyphScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/glyphSwatches"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- One tile per app: tap to upload an image for that app's icon. -->
            <TextView
                style="@style/SectionHeader"
                android:text="@string/icon_images" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/icon_images_hint"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/iconImageRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/appsHeader"
                style="@style/SectionHeader"
                android:text="@string/apps_header" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApps"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/choose_apps"
                app:cornerRadius="26dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
