<?xml version="1.0" encoding="utf-8"?>
<!-- One phone mockup in the theme preview carousel; the card keeps a phone's 9:19.5 shape. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.MrBRos.wallpapercreator.PhoneFrame
        android:id="@+id/phone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="#FF111111"
            app:cardCornerRadius="30dp"
            app:cardElevation="8dp"
            app:contentPadding="5dp"
            app:strokeColor="#FF2A2D33"
            app:strokeWidth="2dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="25dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <com.MrBRos.wallpapercreator.HomeMockView
                    android:id="@+id/mock"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.card.MaterialCardView>
    </com.MrBRos.wallpapercreator.PhoneFrame>
</FrameLayout>
