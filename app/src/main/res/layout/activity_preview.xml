<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen preview of bundled and saved wallpapers, laid out like a cloud post: back and the
  page counter on top, the action rail on the right, Set at the bottom. Tap hides them all.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top overlay -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_scrim_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_glass"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@android:color/white" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_neutral"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Bottom overlay -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_card_scrim"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="36dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSet"
            style="@style/PrimaryPill"
            android:text="@string/set_static" />
    </LinearLayout>

    <!-- Right rail, as on a cloud post: Akhu, like, motion, edit, save, share. -->
    <LinearLayout
        android:id="@+id/rail"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="128dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/avatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher_round" />

        <ImageButton
            android:id="@+id/btnLike"
            style="@style/RailButton"
            android:contentDescription="@string/like"
            android:src="@drawable/ic_heart_outline" />

        <TextView
            android:id="@+id/likeLabel"
            style="@style/RailLabel"
            android:text="@string/like" />

        <LinearLayout
            android:id="@+id/liveItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnLive"
                style="@style/RailButton"
                android:contentDescription="@string/action_live"
                android:src="@drawable/ic_nav_motion" />

            <TextView
                style="@style/RailLabel"
                android:text="@string/action_live" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/editItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnEdit"
                style="@style/RailButton"
                android:contentDescription="@string/action_edit"
                android:src="@drawable/ic_nav_create" />

            <TextView
                style="@style/RailLabel"
                android:text="@string/action_edit" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSave"
            style="@style/RailButton"
            android:contentDescription="@string/save"
            android:src="@drawable/ic_download" />

        <TextView
            style="@style/RailLabel"
            android:text="@string/save" />

        <ImageButton
            android:id="@+id/btnShare"
            style="@style/RailButton"
            android:contentDescription="@string/share"
            android:src="@drawable/ic_share" />

        <TextView
            style="@style/RailLabel"
            android:text="@string/share" />
    </LinearLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@android:color/white" />
</FrameLayout>
