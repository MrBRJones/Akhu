<?xml version="1.0" encoding="utf-8"?>
<!-- Create tab: one big preview, one primary action, a quiet secondary row, and an
     Instagram-style 2D / 3D / MOTION / THEME mode strip at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/previewCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="32dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/surface_muted"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/preview"
            android:scaleType="center"
            android:src="@drawable/ic_add_photo" />

        <TextView
            android:id="@+id/previewHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="56dp"
            android:text="@string/tap_to_pick"
            android:textColor="@color/text_secondary" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/pick_first"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/uploadProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="100"
        android:visibility="gone"
        app:trackCornerRadius="4dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPrimary"
        style="@style/PrimaryPill"
        android:layout_marginTop="10dp"
        android:text="@string/create_action" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownload"
            style="@style/QuietAction"
            android:text="@string/download"
            app:icon="@drawable/ic_download" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpload"
            style="@style/QuietAction"
            android:text="@string/upload"
            app:icon="@drawable/ic_upload" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPost"
            style="@style/QuietAction"
            android:text="@string/post"
            app:icon="@drawable/ic_send" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMore"
            style="@style/QuietAction"
            android:text="@string/more" />
    </LinearLayout>

    <!-- 2D / 3D / MOTION / THEME mode strip, like Instagram's POST / STORY / REEL row. -->
    <LinearLayout
        android:id="@+id/modeStrip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mode2D"
            style="@style/ModeTab"
            android:text="@string/mode_2d" />

        <TextView
            android:id="@+id/modeFourD"
            style="@style/ModeTab"
            android:text="@string/mode_fourd" />

        <TextView
            android:id="@+id/modeMotion"
            style="@style/ModeTab"
            android:text="@string/mode_motion" />

        <TextView
            android:id="@+id/modeTheme"
            style="@style/ModeTab"
            android:text="@string/mode_theme" />
    </LinearLayout>
</LinearLayout>
