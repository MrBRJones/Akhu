<?xml version="1.0" encoding="utf-8"?>
<!--
  A cloud post, full screen like the preview: the back button on top, the poster / like / comment /
  share rail on the right and the title and Set button at the bottom. Tap hides them all.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/preview"
        android:scaleType="fitCenter" />

    <!-- Video posts stream here over the thumbnail; hidden for photos. -->
    <VideoView
        android:id="@+id/video"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@android:color/white" />

    <!-- Top overlay -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_scrim_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_glass"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Bottom overlay: title, poster, Set. -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_card_scrim"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="36dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="72dp"
            android:shadowColor="#99000000"
            android:shadowRadius="4"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="72dp"
            android:layout_marginBottom="16dp"
            android:minHeight="32dp"
            android:gravity="center_vertical"
            android:shadowColor="#99000000"
            android:shadowRadius="4"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSet"
            style="@style/PrimaryPill"
            android:text="@string/set_static" />
    </LinearLayout>

    <!-- Right rail, TikTok style: poster with a follow "+", like, comment, share. -->
    <LinearLayout
        android:id="@+id/rail"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="200dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="64dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/avatar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/bg_avatar"
                android:contentDescription="@string/view_profile"
                android:padding="1dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person" />

            <ImageButton
                android:id="@+id/btnFollow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/bg_follow_badge"
                android:contentDescription="@string/follow"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_plus"
                android:visibility="gone"
                app:tint="@android:color/white" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnLike"
            style="@style/RailButton"
            android:contentDescription="@string/like"
            android:src="@drawable/ic_heart_outline" />

        <TextView
            android:id="@+id/likeCount"
            style="@style/RailLabel" />

        <ImageButton
            android:id="@+id/btnComment"
            style="@style/RailButton"
            android:contentDescription="@string/comments"
            android:src="@drawable/ic_comment" />

        <TextView
            android:id="@+id/commentCount"
            style="@style/RailLabel" />

        <ImageButton
            android:id="@+id/btnShare"
            style="@style/RailButton"
            android:contentDescription="@string/share"
            android:src="@drawable/ic_share" />

        <TextView
            style="@style/RailLabel"
            android:text="@string/share" />
    </LinearLayout>
</FrameLayout>
