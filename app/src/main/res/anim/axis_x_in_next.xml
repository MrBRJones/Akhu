<?xml version="1.0" encoding="utf-8"?>
<!-- M3 shared axis X: the next page slides in from the right while fading in. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <translate android:duration="300" android:fromXDelta="12%" android:toXDelta="0" />
    <alpha android:duration="210" android:startOffset="90" android:fromAlpha="0" android:toAlpha="1" />
</set>
