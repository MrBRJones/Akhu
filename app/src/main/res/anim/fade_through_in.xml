<?xml version="1.0" encoding="utf-8"?>
<!-- M3 fade through: the new page fades in and grows slightly once the old one has faded. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <alpha android:duration="210" android:startOffset="90" android:fromAlpha="0" android:toAlpha="1" />
    <scale android:duration="210" android:startOffset="90" android:fromXScale="0.92" android:fromYScale="0.92"
        android:pivotX="50%" android:pivotY="50%" android:toXScale="1" android:toYScale="1" />
</set>
