<?xml version="1.0" encoding="utf-8"?>
<!-- M3 shared axis X, going back: the current page slides out to the right while fading out. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <translate android:duration="300" android:fromXDelta="0" android:toXDelta="12%" />
    <alpha android:duration="90" android:fromAlpha="1" android:toAlpha="0" />
</set>
