<resources>

    <!-- Classic blue/purple look (values/colors.xml, values-night for dark). A custom app color
         from Settings replaces it at runtime through DynamicColors plus ThemeOverlay.Akhu.AppColor
         (see App). -->
    <style name="Base.Theme.Akhu" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/classic_brand_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/classic_brand_primary_soft</item>
        <item name="colorSecondaryContainer">@color/classic_brand_primary_soft</item>
        <item name="colorOnSecondaryContainer">@color/classic_brand_primary</item>
        <item name="colorSecondary">@color/classic_brand_secondary</item>
        <item name="colorSurface">@color/classic_surface</item>
        <item name="akhuBrandPrimary">@color/classic_brand_primary</item>
        <item name="akhuBrandSecondary">@color/classic_brand_secondary</item>
        <item name="akhuBrandPrimarySoft">@color/classic_brand_primary_soft</item>
        <item name="akhuSurface">@color/classic_surface</item>
        <item name="akhuSurfaceMuted">@color/classic_surface_muted</item>
        <item name="akhuTextPrimary">@color/classic_text_primary</item>
        <item name="akhuTextSecondary">@color/classic_text_secondary</item>
        <item name="akhuTextTertiary">@color/classic_text_tertiary</item>
        <item name="akhuInverseSurface">@color/classic_inverse_surface</item>
        <item name="akhuOnInverseSurface">@color/classic_on_inverse_surface</item>
        <item name="akhuGradientStart">@color/gradient_start</item>
        <item name="akhuGradientCenter">@color/gradient_center</item>
        <item name="akhuGradientEnd">@color/gradient_end</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <!-- One typeface everywhere (values/type.xml): plain TextViews and every M3 text role. -->
        <item name="android:fontFamily">@font/akhu_sans</item>
        <item name="fontFamily">@font/akhu_sans</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Akhu.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Akhu.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Akhu.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Akhu.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Akhu.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Akhu.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Akhu.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Akhu.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Akhu.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Akhu.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Akhu.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Akhu.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Akhu.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Akhu.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Akhu.LabelSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/Shape.Akhu.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.Akhu.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.Akhu.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/Shape.Akhu.Large</item>
    </style>

    <style name="Theme.Akhu" parent="Base.Theme.Akhu" />

    <!-- Applied with custom app colors: the app colors follow the M3 roles built from the main color,
         and the banner gradient runs from the main color to the second. -->
    <style name="ThemeOverlay.Akhu.AppColor" parent="">
        <item name="akhuBrandPrimary">?attr/colorPrimary</item>
        <item name="akhuBrandSecondary">@color/app_color_2</item>
        <item name="akhuBrandPrimarySoft">?attr/colorPrimaryContainer</item>
        <item name="akhuSurface">?attr/colorSurface</item>
        <item name="akhuSurfaceMuted">?attr/colorSurfaceContainer</item>
        <item name="akhuTextPrimary">?attr/colorOnSurface</item>
        <item name="akhuTextSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="akhuTextTertiary">?attr/colorOutline</item>
        <item name="akhuInverseSurface">?attr/colorSurfaceInverse</item>
        <item name="akhuOnInverseSurface">?attr/colorOnSurfaceInverse</item>
        <item name="akhuGradientStart">@color/app_color_1</item>
        <item name="akhuGradientCenter">@color/app_color_mid</item>
        <item name="akhuGradientEnd">@color/app_color_2</item>
    </style>

    <style name="Theme.Akhu.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="ButtonRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="RowButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">4dp</item>
    </style>

    <style name="RowButton.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">4dp</item>
    </style>

    <style name="RowButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">4dp</item>
    </style>

    <!-- Big blue rounded call-to-action, like "Copy Support Email" in the reference. -->
    <style name="PrimaryPill" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">28dp</item>
        <item name="backgroundTint">@color/brand_primary</item>
    </style>

    <!-- Translucent icon-over-label action used on the full-screen preview. -->
    <style name="GlassAction" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="iconTint">@android:color/white</item>
        <item name="iconGravity">top</item>
        <item name="iconPadding">4dp</item>
        <item name="backgroundTint">#33FFFFFF</item>
        <item name="rippleColor">#55FFFFFF</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="MotionTabText" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="DarkDialogOption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:drawablePadding">18dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SheetOption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:drawablePadding">18dp</item>
        <item name="android:drawableTint">@color/text_primary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Theme.Akhu.Preview" parent="Theme.Akhu.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="TopPill" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/surface_muted</item>
        <item name="cornerRadius">18dp</item>
    </style>

    <style name="SortPill" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:checkable">true</item>
        <item name="backgroundTint">@color/pill_bg</item>
        <item name="android:textColor">@color/pill_text</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="CategoryChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/pill_bg</item>
        <item name="android:textColor">@color/pill_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:checkable">true</item>
    </style>

    <!-- Motion editor (always dark, like Instagram's): round icon buttons, tool row items and tabs. -->
    <style name="EditorIconButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="EditorTool">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">52dp</item>
        <item name="android:paddingHorizontal">3dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="EditorTab" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="strokeColor">#4DFFFFFF</item>
        <item name="backgroundTint">@color/editor_tab_bg</item>
    </style>

    <style name="TextToolTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:background">@drawable/bg_text_tab</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SliderLabelRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="SliderLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
    </style>

    <style name="SliderValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <!-- Small borderless icon+label action under the Create screen's main button. -->
    <style name="QuietAction" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">6dp</item>
    </style>

    <!-- One label in the Create screen's 4D / MOTION / THEME strip. -->
    <style name="ModeTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/mode_tab_text</item>
        <item name="android:background">@drawable/bg_mode_tab</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
