<resources>
    <!-- Keep the classic system-bar layout instead of forced edge-to-edge on API 35. -->
    <style name="Theme.Akhu" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/classic_brand_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/classic_brand_primary_soft</item>
        <item name="colorSecondaryContainer">@color/classic_brand_primary_soft</item>
        <item name="colorOnSecondaryContainer">@color/classic_brand_primary</item>
        <item name="colorSecondary">@color/classic_brand_secondary</item>
        <item name="colorSurface">@color/classic_surface</item>
        <item name="akhuBrandPrimary">@color/classic_brand_primary</item>
        <item name="akhuBrandSecondary">@color/classic_brand_secondary</item>
        <item name="akhuBrandPrimarySoft">@color/classic_brand_primary_soft</item>
        <item name="akhuSurface">@color/classic_surface</item>
        <item name="akhuSurfaceMuted">@color/classic_surface_muted</item>
        <item name="akhuTextPrimary">@color/classic_text_primary</item>
        <item name="akhuTextSecondary">@color/classic_text_secondary</item>
        <item name="akhuTextTertiary">@color/classic_text_tertiary</item>
        <item name="akhuInverseSurface">@color/classic_inverse_surface</item>
        <item name="akhuOnInverseSurface">@color/classic_on_inverse_surface</item>
        <item name="akhuGradientStart">@color/gradient_start</item>
        <item name="akhuGradientCenter">@color/gradient_center</item>
        <item name="akhuGradientEnd">@color/gradient_end</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
