<?xml version="1.0" encoding="utf-8"?>
<!-- The theme clock: 4x2, styled by the theme last set up with One-Tap Setup (or the one it was placed with). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/clock_widget_description"
    android:initialLayout="@layout/widget_clock"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="70dp"
    android:previewLayout="@layout/widget_clock"
    android:previewImage="@mipmap/ic_launcher"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
