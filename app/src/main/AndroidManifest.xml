<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />

    <!-- Lets the theme editor list launchable apps to restyle. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WallpaperCreator">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.WallpaperCreator.NoActionBar"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".VideoEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.WallpaperCreator.NoActionBar"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".AuthActivity"
            android:exported="false"
            android:label="@string/sign_in"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".PreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.WallpaperCreator.Preview" />
        <activity
            android:name=".ThemePreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.WallpaperCreator.Preview" />
        <!-- Handles fold/rotate itself so unsaved cut-out edits survive. -->
        <activity
            android:name=".FourDEditorActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density"
            android:theme="@style/Theme.WallpaperCreator.NoActionBar" />
        <activity
            android:name=".ThemeEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.WallpaperCreator.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".WallpaperDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <!-- Exported so the system live wallpaper picker can open it as the settings screen. -->
        <activity
            android:name=".LiveWallpaperSettingsActivity"
            android:exported="true"
            android:label="@string/live_settings"
            android:parentActivityName=".MainActivity" />

        <service
            android:name=".LiveWallpaperService"
            android:exported="true"
            android:label="@string/live_wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_info" />
        </service>

        <service
            android:name=".VideoWallpaperService"
            android:exported="true"
            android:label="@string/video_wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/video_wallpaper_info" />
        </service>

        <service
            android:name=".FourDWallpaperService"
            android:exported="true"
            android:label="@string/fourd_wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/fourd_wallpaper_info" />
        </service>

        <receiver
            android:name=".WallpaperWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
        <receiver
            android:name=".WidgetSetWallpaperReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.MrBRos.wallpapercreator.SET_WALLPAPER" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Fetch the on-device subject cut-out model with the app, for "Make it 4D". -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="subject_segment" />
    </application>
</manifest>
