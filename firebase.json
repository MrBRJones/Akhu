{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "hosting",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*"
    ]
  }
}
